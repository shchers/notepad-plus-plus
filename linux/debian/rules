#!/usr/bin/make -f
# Builds the GTK port in linux/ against the upstream tree at the package root.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CXXFLAGS_MAINT_APPEND = -Wall

%:
	dh $@ --sourcedirectory=linux --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DNPP_BUILD_TESTS=$(if $(filter nocheck,$(DEB_BUILD_OPTIONS)),OFF,ON)

# CPack maintainer scripts are not used here: debhelper's triggers
# (dh_icons, desktop-file-utils) refresh the icon/desktop caches.

# copyright and changelog.Debian.gz come from debian/ through debhelper, for
# both packages; the copies CMake installs for the CPack route are not needed.
override_dh_missing:
	dh_missing --fail-missing -Xusr/share/doc/notepad-plus-plus-gtk/copyright -Xusr/share/doc/notepad-plus-plus-gtk/changelog.Debian.gz
