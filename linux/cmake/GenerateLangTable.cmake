# Generates LangTable.generated.h from upstream's
# ScintillaEditView::_langNameInfoArray, the authoritative mapping from
# Notepad++ language names (as used in langs.model.xml / stylers.model.xml)
# to Lexilla lexer names. Re-runs whenever that upstream file changes.

set(_sev "${NPP_SRC}/ScintillaComponent/ScintillaEditView.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_sev}")

file(STRINGS "${_sev}" _rows
  REGEX "^[ \t]*\\{L\"[^\"]*\",[ \t]*L\"[^\"]*\",[ \t]*L\"[^\"]*\",[ \t]*L_[A-Z0-9_]+,[ \t]*\"[^\"]*\"\\}")

set(_body "")
set(_count 0)
foreach(_row IN LISTS _rows)
  string(REGEX MATCH
    "\\{L\"([^\"]*)\",[ \t]*L\"([^\"]*)\",[ \t]*L\"([^\"]*)\",[ \t]*(L_[A-Z0-9_]+),[ \t]*\"([^\"]*)\"\\}"
    _m "${_row}")
  # Escape backslashes/quotes defensively (none today, but keep generator safe).
  foreach(_i 1 2 3 5)
    string(REPLACE "\\" "\\\\" _g${_i} "${CMAKE_MATCH_${_i}}")
    string(REPLACE "\"" "\\\"" _g${_i} "${_g${_i}}")
  endforeach()
  string(APPEND _body "    {\"${_g1}\", \"${_g2}\", \"${_g3}\", \"${CMAKE_MATCH_4}\", \"${_g5}\"},\n")
  math(EXPR _count "${_count} + 1")
endforeach()

if(_count LESS 50)
  message(FATAL_ERROR "Language table extraction found only ${_count} rows in ${_sev}; "
                      "upstream format probably changed — update GenerateLangTable.cmake")
endif()

set(NPP_GENERATED_DIR "${CMAKE_BINARY_DIR}/generated")
set(_out "${NPP_GENERATED_DIR}/LangTable.generated.h")
set(_content "// Generated by linux/cmake/GenerateLangTable.cmake from\n// PowerEditor/src/ScintillaComponent/ScintillaEditView.cpp. Do not edit.\n#pragma once\n\nnamespace npp::gen {\n\nstruct LangRow {\n    const char* name;      // langs.model.xml <Language name=...>\n    const char* shortName; // UI name\n    const char* longName;  // file-type description\n    const char* langId;    // upstream LangType enumerator\n    const char* lexer;     // Lexilla lexer name (\"null\" = plain text)\n};\n\ninline constexpr LangRow kLangTable[] = {\n${_body}};\n\n} // namespace npp::gen\n")

# Only touch the file when content changes, to avoid needless rebuilds.
if(EXISTS "${_out}")
  file(READ "${_out}" _old)
else()
  set(_old "")
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${_out}" "${_content}")
endif()
message(STATUS "Generated language table: ${_count} languages")
